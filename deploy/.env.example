# Copy to deploy/.env on the server and fill in. Never commit the real file.

# Public hostname pointing at this server, e.g. patrika.duckdns.org (no https://, no slash).
DOMAIN=patrika.duckdns.org

# Generate each with: openssl rand -hex 32
JWT_SECRET=
POSTGRES_PASSWORD=

# Google OAuth client (add https://DOMAIN/api/auth/google/callback as a redirect URI).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Slack app (redirect URL https://DOMAIN/api/slack/callback, scope incoming-webhook).
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Optional: use an external Postgres (e.g. Neon's *direct* connection string) instead of the
# bundled one. Leave empty to use the postgres container.
DATABASE_URL=

# Throughput and limits (same meaning as in backend/.env.example).
WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_SENDS_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
MAX_CAMPAIGN_HOURLY_LIMIT=1000
SEND_ATTEMPTS=3
SENDER_COUNT=3
