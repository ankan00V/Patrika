# ---- Core ----------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Public URL of the dashboard. The browser only ever talks to this origin; Next.js proxies
# /api/* and /admin/queues to this backend, so cookies and OAuth redirects stay same-origin.
APP_URL=http://localhost:3000
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# ---- Infra (matches docker-compose.yml) ---------------------------------------------
DATABASE_URL=postgres://patrika:patrika@localhost:5432/patrika
REDIS_URL=redis://localhost:6379
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=patrika-emails

# ---- Google OAuth (https://console.cloud.google.com/apis/credentials) ---------------
# Authorized redirect URI: ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Slack OAuth (https://api.slack.com/apps -> OAuth & Permissions) ----------------
# Scope: incoming-webhook. Redirect URL: ${APP_URL}/api/slack/callback (Slack requires https,
# so expose the dashboard with a tunnel such as ngrok/cloudflared and set APP_URL to it).
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# ---- Sending -------------------------------------------------------------------------
# Leave empty to auto-create SENDER_COUNT Ethereal mailboxes on first boot (stored in Postgres).
# Or list your own Ethereal logins: user1@ethereal.email:pass1,user2@ethereal.email:pass2
ETHEREAL_SENDERS=
SENDER_COUNT=3

# ---- Throughput & rate limits ----------------------------------------------------------
# Jobs processed in parallel per worker process.
WORKER_CONCURRENCY=5
# Minimum gap between any two sends across all workers (BullMQ limiter, Redis-backed).
MIN_DELAY_BETWEEN_SENDS_MS=2000
# Hard cap per sender mailbox per clock hour (Redis counters, shared by all workers).
MAX_EMAILS_PER_HOUR_PER_SENDER=200
# Highest per-campaign hourly limit a user may choose in the compose form.
MAX_CAMPAIGN_HOURLY_LIMIT=1000
# SMTP attempts before an email is marked failed (exponential backoff from 30s).
SEND_ATTEMPTS=3
