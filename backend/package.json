{
  "name": "@patrika/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:api": "tsx watch --clear-screen=false src/api.ts",
    "dev:worker": "tsx watch --clear-screen=false src/worker.ts",
    "start:api": "node dist/api.js",
    "start:worker": "node dist/worker.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@bull-board/api": "^9.10.5",
    "@bull-board/express": "^9.10.5",
    "@elastic/elasticsearch": "^8.19.2",
    "bullmq": "^5.81.5",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^7.0.13",
    "pg": "^8.23.1",
    "pino": "^9.14.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^7.0.12",
    "@types/pg": "^8.23.1",
    "@types/smtp-server": "^3.5.13",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "smtp-server": "^3.21.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
